{
    "name":  "slidewise-ai-tutor",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
                    "dev:web":  "vite --config frontend/vite.config.ts",
                    "dev:server":  "tsx watch backend/src/index.ts",
                    "start:server":  "tsx backend/src/index.ts",
                    "build":  "npm run typecheck \u0026\u0026 vite build --config frontend/vite.config.ts",
                    "preview":  "vite preview --config frontend/vite.config.ts",
                    "lint":  "eslint frontend/src backend/src eval",
                    "typecheck":  "tsc -b frontend/tsconfig.json backend/tsconfig.json --pretty false",
                    "test":  "npm run test:web \u0026\u0026 npm run test:server",
                    "test:golden":  "vitest run --config frontend/vite.config.ts frontend/src/rag",
                    "test:llm":  "vitest run backend/src/llm backend/src/tutor backend/src/slides",
                    "eval:validate":  "tsx eval/validate-eval.ts",
                    "eval:run":  "tsx eval/run-eval.ts",
                    "test:web":  "vitest run --config frontend/vite.config.ts",
                    "test:server":  "vitest run backend/src"
                },
    "dependencies":  {
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "react":  "^19.1.1",
                         "react-dom":  "^19.1.1",
                         "react-pdf":  "^10.4.1",
                         "tesseract.js":  "^7.0.0",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.32.0",
                            "@testing-library/jest-dom":  "^6.6.4",
                            "@testing-library/react":  "^16.3.0",
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^24.1.0",
                            "@types/react":  "^19.1.9",
                            "@types/react-dom":  "^19.1.7",
                            "@vitejs/plugin-react":  "^4.6.0",
                            "concurrently":  "^10.0.4",
                            "eslint":  "^9.32.0",
                            "eslint-plugin-react-hooks":  "^5.2.0",
                            "eslint-plugin-react-refresh":  "^0.4.20",
                            "globals":  "^16.3.0",
                            "jsdom":  "^26.1.0",
                            "pdf-lib":  "^1.17.1",
                            "tsx":  "^4.23.1",
                            "typescript":  "~5.8.3",
                            "typescript-eslint":  "^8.38.0",
                            "vite":  "^7.0.6",
                            "vitest":  "^3.2.4"
                        }
}
