# Primary OpenAI-compatible provider (required)
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PRIMARY_API_KEY=replace_with_your_server_side_key
LLM_PRIMARY_MODEL=replace_with_an_available_model

# Optional fallback. Configure all four variables or leave all four empty.
# LLM_FALLBACK_PROVIDER=nvidia
# LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_FALLBACK_API_KEY=replace_with_your_fallback_key
# LLM_FALLBACK_MODEL=replace_with_an_available_fallback_model

LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_MS=250
PORT=3001

# Python executable used for unstructured.partition.pdf.
PYTHON_EXECUTABLE=python
